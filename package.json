{
  "name": "pet-pet-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspace pet-pet-demo dev",
    "build": "yarn build:lib && yarn build:demo",
    "build:lib": "yarn workspace pet-pet build",
    "build:demo": "yarn workspace pet-pet-demo build",
    "type-check": "tsc -b packages/pet-pet apps/demo",
    "lint": "oxlint",
    "test": "yarn workspace pet-pet test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
